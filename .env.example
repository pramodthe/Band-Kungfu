# Create two remote agents in Band and add both to the same room.
# The reporter posts run summaries. The analyst receives and responds to them.
BAND_ROOM_ID=
BAND_REPORTER_API_KEY=
ANALYST_AGENT_ID=
ANALYST_API_KEY=
# Optional: if omitted, the analyst uses an authenticated local Codex CLI.
OPENAI_API_KEY=
BAND_MODEL=gpt-6-luna
# Watch AI Play: a separate player agent in a private room with only you and the player.
PLAYER_AGENT_ID=
PLAYER_API_KEY=
PLAYER_ROOM_ID=
# Optional model override. Otherwise uses BAND_MODEL, or the signed-in Codex CLI.
PLAYER_MODEL=
# Public hosting: production defaults to three visitors sharing 120 model decisions per hour.
# Limits are per server instance and reset on restart.
AI_MAX_SESSIONS=3
AI_MAX_DECISIONS_PER_HOUR=120
# Agent Arena: two distinct BAND agents, each in a private room with only you.
ALLY_AGENT_ID=
ALLY_API_KEY=
ALLY_ROOM_ID=
BOSS_AGENT_ID=
BOSS_API_KEY=
BOSS_ROOM_ID=
