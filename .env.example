# Create two remote agents in Band and add both to the same room.
# The reporter posts run summaries. The analyst receives and responds to them.
BAND_ROOM_ID=
BAND_REPORTER_API_KEY=
ANALYST_AGENT_ID=
ANALYST_API_KEY=
# Optional: if omitted, the analyst uses an authenticated local Codex CLI.
OPENAI_API_KEY=
BAND_MODEL=gpt-4.1-mini
