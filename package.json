{
  "name": "band-kungfu",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.9.0 <23" },
  "description": "Band Kungfu, a browser based voxel crowd brawler with BAND AI spectator play and an optional run analyst.",
  "scripts": {
    "start": "node --env-file-if-exists=.env serve.mjs",
    "band:analyst": "node --env-file-if-exists=.env agents/analyst.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@band-ai/sdk": "^0.6.0",
    "openai": "^7.30.0",
    "zod": "^4.6.5"
  }
}
